            "name":"Custom bindabl",
            "value":1
        },
        "slotType" : "sirencontroller_keybind",
        "controller": [
            ["fileName"],
            ["politi_sirencontroller", {"keyBind": "ChangeSirenEV"}]
        ],
        "actionsEnabled": [
