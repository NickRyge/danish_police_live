{
    "lansdale_politi": {
        "information":{
            "authors":"BeamNGxNickRyge",
            "name":"Danish Police Lights",
            "value":100
        },
        "slotType" : "lansdale_roof_accessory",
        "slots": [
            ["type", "default", "description"],
            ["soundscape_siren","politi_sirencontroller_insert", "Siren Audio"],
            ["bumper_light_front","lansdale_politi_bumper_early", "bumper type for bumper flashers"],
            ["bumper_light_rear","lansdale_politi_rear_bumper", "Type for rear flashers"],
            ["roof_light","roof_beacons", "Roof lights"],
            ["mirror_light","", "Side mirror lights"],
            ["trunk_lights", "lansdale_trunklights_wagon", "Trunk lights"],
            ["politi_lights_pattern", "politi_pattern_standard", "Lightbar pattern", {"coreSlot":true}]
        ],
        "soundscape": [
            ["name", "src"],
            {"node:":"f15"},
        ]
    },
    
    //F
    "lansdale_trunklights_wagon": {
        "information":{
            "authors":"NickRyge",
            "name":"Wagon trunklights",
            "value":10
        },
        "slotType" : "trunk_lights",
        "glowMap":{
    
            "generic_flasher_led_TRNK_R": {"simpleFunction":{"tailgateCoupler_notAttached":1, "blue_l1":0.4, "1":-1}, "off":"policeparts_lights_blue", "on":"policeparts_lights_blue_on_bright"},
            "generic_flasher_led_TRNK_L": {"simpleFunction":{"tailgateCoupler_notAttached":1, "blue_r1":0.4, "1":-1}, "off":"policeparts_lights_blue", "on":"policeparts_lights_blue_on_bright"},
        
            },
        "flexbodies": [
            ["mesh", "[group]:", "nonFlexMaterials"],
    
            //I don't know whether it makes any sense to provide any breakgroups as additional beams with no strength perhaps?
            {"deformGroup":"tailgatelight_R_break", "deformMaterialBase":"policeparts_lights_blue", "deformMaterialDamaged":"policeparts_lights_blue"},
            ["generic_flasher_led_TRNK_R", ["lansdale_tailgate"], [], {"pos":{"x": -0.22, "y":2.43, "z":0.393}, "rot":{"x":85, "y":22, "z":22}, "scale":{"x":1.8, "y":0.6, "z":0.6}}],
            {"deformGroup":"tailgatelight_L_break", "deformMaterialBase":"policeparts_lights_blue", "deformMaterialDamaged":"policeparts_lights_blue"},
            ["generic_flasher_led_TRNK_L", ["lansdale_tailgate"], [], {"pos":{"x": 0.22, "y":2.43, "z":0.393}, "rot":{"x":85, "y":-22, "z":-22}, "scale":{"x":1.8, "y":0.6, "z":0.6}}],
            {"deformGroup":"", "deformMaterialBase":"", "deformMaterialDamaged":""}
        ]
    },
    
    //F
    "roof_beacons": {
        "information":{
            "authors":"NickRyge",
            "name":"Danish police triple roof beacons",
            "value":100,
        },
        "slotType" : "roof_light",   
        "glowMap":{
        
            "mod_beacon_light_fr": {"simpleFunction":"roofflasherFR", "off":"policeparts_lights_blue", "on":"policeparts_lights_blue_on_bright"},
            "mod_beacon_glass_fr": {"simpleFunction":"roofflasherFR", "off":"policeparts_glass_blue", "on":"policeparts_glass_blue"},
            
