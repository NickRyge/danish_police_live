"sunburst2_politi_mirror_lights": {
    "information":{
        "authors":"MagnusLind",
        "name":"mirror lights",
        "value":10
    },
    "slotType" : "mirror_light",
    "glowMap":{
        
        "mod_beacon_light_mr":                    {"simpleFunction":"blue_r3", "off":"policeparts_lights_white", "on":"policeparts_lights_blue_on_bright_full"},
        "mod_beacon_glass_mr":                    {"simpleFunction":"blue_r3", "off":"policeparts_glass_white", "on":"policeparts_glass_white"},

        "mod_beacon_light_ml":                    {"simpleFunction":"blue_l3", "off":"policeparts_lights_white", "on":"policeparts_lights_blue_on_bright_full"},
        "mod_beacon_glass_ml":                    {"simpleFunction":"blue_l3", "off":"policeparts_glass_white", "on":"policeparts_glass_white"}

    },
    "props": [
        ["func"      , "mesh"              , "idRef:", "idX:", "idY:"            , "baseRotation"        , "rotation"                 , "translation"        , "min", "max", "offset", "multiplier"],
        {
            "lightInnerAngle":0,
            "lightOuterAngle":110,
            "lightRange":65,
            "lightBrightness": 1.5,
            "lightColor":{"r":10, "g":10, "b":255, "a":0},
            "lightAttenuation":{"x":1, "y":9999999, "z":9999999},
            "flareName":"vehicleBrakeLightFlare",
            "lightCastShadows":false,
            "texSize":32,
            "shadowSoftness":0,
            "flareScale":0,
            //"cookieName":"/vehicles/common/politi/half_cookie.png"
             "cookieName":"/art/special/BNG_light_cookie_lightbar.dds"
        },
        // make a few per light and copy paste to each car.
        ["blue_r3", "SPOTLIGHT", "mi5r", "mi1r", "mi4r", {"x":33.940, "y":66.112, "z":50.593} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0.0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":-0.044, "y":0.079, "z":-0.013},"deformGroup":"beaconlight_break_l"}],            
        ["blue_l3", "SPOTLIGHT", "mi5l", "mi1l", "mi4l", {"x":33.940, "y":66.112, "z":50.593} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0.0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":-0.065, "y":0.053, "z":0.013},"deformGroup":"beaconlight_break_l"}],            
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],

        //The breakgroups don't work, probably because the mirrors have no deform groups. No idea.
        ["mod_beacon_base_mr",  ["sunburst2_mirror_R"], [], {"pos":{"x": -0.89, "y":-0.6, "z":0.949}, "rot":{"x":110, "y":90, "z":0}, "scale":{"x":0.2, "y":0.2, "z":0.9}}],
        {"breakGroup":"mirror_R", "deformMaterialBase":"policeparts_glass_blue", "deformMaterialDamaged":"policeparts_glass_blue_dmg"},
        ["mod_beacon_light_mr", ["sunburst2_mirror_R"], [], {"pos":{"x": -0.8906, "y":-0.6015, "z":0.949}, "rot":{"x":110, "y":90, "z":0}, "scale":{"x":0.2, "y":0.2, "z":0.3}}],
        {"breakGroup":"mirror_R", "deformMaterialBase":"policeparts_glass_blue", "deformMaterialDamaged":"policeparts_glass_blue_dmg"},
        ["mod_beacon_glass_mr", ["sunburst2_mirror_R"], [], {"pos":{"x": -0.8906, "y":-0.6015, "z":0.949}, "rot":{"x":110, "y":90, "z":0}, "scale":{"x":0.2, "y":0.2, "z":0.3}}],
        {"deformGroup":"", "deformMaterialBase":"", "deformMaterialDamaged":""},

        ["mod_beacon_base_ml",  ["sunburst2_mirror_L"], [], {"pos":{"x": 0.89, "y":-0.6, "z":0.949},      "rot":{"x":110, "y":-90, "z":0}, "scale":{"x":0.2, "y":0.2, "z":0.9}}],
        ["mod_beacon_light_ml", ["sunburst2_mirror_L"], [], {"pos":{"x": 0.8906, "y":-0.6015, "z":0.949}, "rot":{"x":110, "y":-90, "z":0}, "scale":{"x":0.2, "y":0.2, "z":0.3}}],
        ["mod_beacon_glass_ml", ["sunburst2_mirror_L"], [], {"pos":{"x": 0.8906, "y":-0.6015, "z":0.949}, "rot":{"x":110, "y":-90, "z":0}, "scale":{"x":0.2, "y":0.2, "z":0.3}}],
        
        {"deformGroup":"", "deformMaterialBase":"", "deformMaterialDamaged":""},
    ],
},


"roof_beacons": {
    "information":{
        "authors":"NickRygexMagnusLind",
        "name":"Danish police triple roof beacons",
        "value":100,
    },
    "slotType" : "roof_light",
    "slots": [
        ["type", "default", "description"],
        ["sunburst_extra_light","sunburst_extra_beacon_sedan", "rear-most roof light",{"coreSlot":true}],
    ],
    "glowMap":{
        "mod_beacon_light":                  	   {"simpleFunction":"roofflasherR", "off":"policeparts_lights_blue", "on":"policeparts_lights_blue_on_bright"},
        "mod_beacon_glass":                        {"simpleFunction":"roofflasherR", "off":"policeparts_glass_blue", "on":"policeparts_glass_blue"},
	
		"mod_beacon_light_fr":                      {"simpleFunction":"roofflasherFR", "off":"policeparts_lights_blue", "on":"policeparts_lights_blue_on_bright"},
        "mod_beacon_glass_fr":                      {"simpleFunction":"roofflasherFR", "off":"policeparts_glass_blue", "on":"policeparts_glass_blue"},
		
		"mod_beacon_light_fl":                      {"simpleFunction":"roofflasherFL", "off":"policeparts_lights_blue", "on":"policeparts_lights_blue_on_bright"},                
        "mod_beacon_glass_fl":                      {"simpleFunction":"roofflasherFL", "off":"policeparts_glass_blue", "on":"policeparts_glass_blue"},
			
        },
    "props": [
        ["func"      , "mesh"              , "idRef:", "idX:", "idY:"            , "baseRotation"        , "rotation"                 , "translation"        , "min", "max", "offset", "multiplier"],
        {
            "lightInnerAngle":0,
            "lightOuterAngle":110,
            "lightRange":75,
            "lightBrightness": 1.5,
            "lightColor":{"r":10, "g":10, "b":255, "a":0},
            "lightAttenuation":{"x":1, "y":9999999, "z":9999999},
            "flareName":"vehicleBrakeLightFlare",
            "lightCastShadows":false,
            "texSize":32,
            "shadowSoftness":0,
            "flareScale":0,
            //"cookieName":"/vehicles/common/politi/half_cookie.png"
             "cookieName":"/art/special/BNG_light_cookie_lightbar.dds"
        },
        // make a few per light and copy paste to each car.
        ["roofflasherFR", "SPOTLIGHT", "rbl1r", "rbl2r", "rbl1l", {"x":97, "y":135, "z":0} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0.0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.5, "y":0.5, "z":0},"deformGroup":"beaconlight_break_r"}],            
        ["roofflasherFR", "SPOTLIGHT", "rbl1r", "rbl2r", "rbl1l", {"x":94, "y":225, "z":0} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0.0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.5, "y":0.5, "z":0},"deformGroup":"beaconlight_break_r"}],            
        ["roofflasherFR", "SPOTLIGHT", "rbl1r", "rbl2r", "rbl1l", {"x":97, "y":315, "z":0} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0.0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.5, "y":0.5, "z":0},"deformGroup":"beaconlight_break_r"}],            
        ["roofflasherFR", "SPOTLIGHT", "rbl1r", "rbl2r", "rbl1l", {"x":95, "y":45,  "z":0} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0.0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.5, "y":0.5, "z":0},"deformGroup":"beaconlight_break_r"}],            

        ["roofflasherFL", "SPOTLIGHT", "lbl1l", "lbl2l", "lbl1r", {"x":95, "y":135, "z":0} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0.0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.5, "y":0.5, "z":0},"deformGroup":"beaconlight_break_l"}],            
        ["roofflasherFL", "SPOTLIGHT", "lbl1l", "lbl2l", "lbl1r", {"x":97, "y":225, "z":0} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0.0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.5, "y":0.5, "z":0},"deformGroup":"beaconlight_break_l"}],            
        ["roofflasherFL", "SPOTLIGHT", "lbl1l", "lbl2l", "lbl1r", {"x":94, "y":315, "z":0} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0.0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.5, "y":0.5, "z":0},"deformGroup":"beaconlight_break_l"}],            
        ["roofflasherFL", "SPOTLIGHT", "lbl1l", "lbl2l", "lbl1r", {"x":97, "y":45,  "z":0} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0.0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.5, "y":0.5, "z":0},"deformGroup":"beaconlight_break_l"}],            
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
		
		//Oriented in left to right for the deform groups. Sorry.
        {"deformGroup":"", "deformMaterialBase":"", "deformMaterialDamaged":""},		
		["mod_beacon_base_fr", ["sunburst2_lightbar_r"], [], {"pos":{"x": -0.38, "y":0, "z":1.369}, "rot":{"x":2.5, "y":-5, "z":3}, "scale":{"x":1.12, "y":1.12, "z":1.512}}],
        {"deformGroup":"beaconlight_break_r", "deformMaterialBase":"policeparts_lights_blue", "deformMaterialDamaged":"policeparts_lights_blue"},
        ["mod_beacon_light_fr", ["sunburst2_lightbar_r"], [], {"pos":{"x": -0.38, "y":0, "z":1.369}, "rot":{"x":2.5, "y":-5, "z":3}, "scale":{"x":1.12, "y":1.12, "z":1.512}}],
        {"deformGroup":"beaconlight_break_r", "deformMaterialBase":"policeparts_glass_blue", "deformMaterialDamaged":"policeparts_glass_blue_dmg"},
        ["mod_beacon_glass_fr", ["sunburst2_lightbar_r"], [], {"pos":{"x": -0.38, "y":0, "z":1.369}, "rot":{"x":2.5, "y":-5, "z":3}, "scale":{"x":1.12, "y":1.12, "z":1.512}}],
        {"deformGroup":"", "deformMaterialBase":"", "deformMaterialDamaged":""},
		
		["mod_beacon_base_fl", ["sunburst2_lightbar_l"], [], {"pos":{"x": 0.38, "y":0, "z":1.369}, "rot":{"x":2.5, "y":5, "z":3}, "scale":{"x":1.12, "y":1.12, "z":1.512}}],
        {"deformGroup":"beaconlight_break_l", "deformMaterialBase":"policeparts_lights_blue", "deformMaterialDamaged":"policeparts_lights_blue"},
        ["mod_beacon_light_fl", ["sunburst2_lightbar_l"], [], {"pos":{"x": 0.38, "y":0, "z":1.369}, "rot":{"x":2.5, "y":5, "z":3}, "scale":{"x":1.12, "y":1.12, "z":1.512}}],
        {"deformGroup":"beaconlight_break_l", "deformMaterialBase":"policeparts_glass_blue", "deformMaterialDamaged":"policeparts_glass_blue_dmg"},
        ["mod_beacon_glass_fl", ["sunburst2_lightbar_l"], [], {"pos":{"x": 0.38, "y":0, "z":1.369}, "rot":{"x":2.5, "y":5, "z":3}, "scale":{"x":1.12, "y":1.12, "z":1.512}}],
        {"deformGroup":"", "deformMaterialBase":"", "deformMaterialDamaged":""},

    ],
     "nodes": [
        ["id", "posX", "posY", "posZ"],
            
        {"selfCollision":true},
        {"collision":true},
        {"nodeWeight":0.50},
        {"frictionCoef":0.7},
        {"nodeMaterial":"|NM_METAL"},
            
        //right - using offset because its easier
        {"group":"sunburst2_lightbar_r"},
        ["rbl1l", -0.385, 0, 1.45, {"nodeOffset":{"x":-0.09, "y":0.09, "z":-0.071}}],
        ["rbl2l", -0.385, 0, 1.45, {"nodeOffset":{"x":-0.09, "y":-0.09, "z":-0.083}}],
        ["rbl3", -0.385, 0, 1.435],
        ["rbl1r", -0.385, 0, 1.45, {"nodeOffset":{"x":0.09, "y":0.09, "z":-0.083}}],
        ["rbl2r", -0.385, 0, 1.45, {"nodeOffset":{"x":0.09, "y":-0.09, "z":-0.090}}],
        {"group":""},

        //left
        //I know the node names are mirrored. Sue me.
        {"group":"sunburst2_lightbar_l"},
        ["lbl1l", 0.385, 0, 1.45, {"nodeOffset":{"x":-0.09, "y":0.09, "z":-0.071}}],
        ["lbl2l", 0.385, 0, 1.45, {"nodeOffset":{"x":-0.09, "y":-0.09, "z":-0.083}}],
        ["lbl3", 0.385, 0, 1.435],
        ["lbl1r", 0.385, 0, 1.45, {"nodeOffset":{"x":0.09, "y":0.09, "z":-0.083}}],
        ["lbl2r", 0.385, 0, 1.45, {"nodeOffset":{"x":0.09, "y":-0.09, "z":-0.09}}],
        {"group":""},

    ],

    "beams": [
        ["id1:", "id2:"],
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamSpring":601000,"beamDamp":60},
        {"beamDeform":8000,"beamStrength":"FLT_MAX"},
        {"deformLimitExpansion":1.1},

        //Main shape right
        {"deformGroup":"beaconlight_break_r"},
        ["rbl1r","rbl1l"],
        ["rbl2r","rbl2l"],
        ["rbl1r","rbl2r"],
        ["rbl1l","rbl2l"],

        ["rbl1r","rbl2l"],
        ["rbl1l","rbl2r"],

        ["rbl1r","rbl3"],
        ["rbl2r","rbl3"],
        ["rbl1l","rbl3"],
        ["rbl2l","rbl3"],
        {"deformGroup":""},

        //Main shape left
        {"deformGroup":"beaconlight_break_l"},
        ["lbl1r","lbl1l"],
        ["lbl2r","lbl2l"],
        ["lbl1r","lbl2r"],
        ["lbl1l","lbl2l"],

        ["lbl1r","lbl2l"],
        ["lbl1l","lbl2r"],

        ["lbl1r","lbl3"],
        ["lbl2r","lbl3"],
        ["lbl1l","lbl3"],
        ["lbl2l","lbl3"],
        {"deformGroup":""},

        //Main shape center
        {"deformGroup":"beaconlight_break"},
        ["bl1r","bl1l"],
        ["bl2r","bl2l"],
        ["bl1r","bl2r"],
        ["bl1l","bl2l"],
    
        ["bl1r","bl2l"],
        ["bl1l","bl2r"],
    
        ["bl1r","bl3"],
        ["bl2r","bl3"],
        ["bl1l","bl3"],
        ["bl2l","bl3"],
    
    
        //To body
        {"deformLimitExpansion":""},
        {"beamSpring":301000,"beamDamp":60},
        {"beamDeform":4000,"beamStrength":8000},
        
        //Right
        {"deformGroup":"beaconlight_break_r"},

        //This to avoid removing the beams that hold the light
        ["rbl3","rbl2l"],
