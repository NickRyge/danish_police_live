{
"sunburst2_politi": {
    "information":{
        "authors":"NickRygexMagnusLind",
        "name":"Danish Police Lights",
        "value":100
    },
    "slotType" : "sunburst2_lightbar",
    "slots": [
        ["type", "default", "description"],
        ["soundscape_siren", "politi_sirencontroller_insert", "Siren Audio"],
        ["bumper_light_front", "sunburst2_politi_bumper_normal", "bumper type for bumper flashers"],
        ["bumper_light_rear", "sunburst2_politi_rear_bumper", "Type for rear flashers"],
        ["roof_light", "roof_beacons", "Roof lights"],
        ["mirror_light", "", "Side mirror lights"],
        ["trunk_lights", "sunburst2_trunklights_sedan", "Trunk lights"],
        ["politi_lights_pattern", "politi_pattern_standard", "Lightbar pattern", {"coreSlot":true}]
        
        //WIP
        //["politi_lightbar_spotlight","sunburst2_politi_spotlight", "Camera-controlled spotlight"],
    ],
    "soundscape": [
        ["name", "src"],
        {"node:":"f15"}
    ]
},


"sunburst2_trunklights_wagon": {
    "information":{
        "authors":"NickRygexMagnusLind",
        "name":"Tailgate lights (wagon)",
        "value":10
    },
    "slotType" : "trunk_lights",
    "components": {
        "electrics": {
            "customValues": [
                ["electricsName", "electricsFunction","electricsDefault"],
                ["trunk_l", "((electrics.tailgateCoupler_notAttached or 0) * (electrics.blue_l5 or 0)) or 0", 0],
                ["trunk_r", "((electrics.tailgateCoupler_notAttached or 0) * (electrics.blue_r5 or 0)) or 0", 0]
            ],

        },
    },
    "glowMap":{

        "generic_flasher_led_TRNK_R":               {"simpleFunction":"trunk_r", "off":"policeparts_lights_blue", "on":"policeparts_lights_blue_on_bright"},
        "generic_flasher_led_TRNK_L":               {"simpleFunction":"trunk_l", "off":"policeparts_lights_blue", "on":"policeparts_lights_blue_on_bright"}
    
        },
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],

		//I don't know whether it makes any sense to provide any breakgroups as additional beams with no strength perhaps?
        {"deformGroup":"tailgateglass_break", "deformMaterialBase":"policeparts_lights_blue", "deformMaterialDamaged":"policeparts_lights_blue"},
        ["generic_flasher_led_TRNK_R", ["sunburst2_trunk"], [], {"pos":{"x": -0.205, "y":2.138, "z":0.575}, "rot":{"x":85, "y":29, "z":30}, "scale":{"x":1.8, "y":0.9, "z":0.6}}],
        {"deformGroup":"tailgateglass_break", "deformMaterialBase":"policeparts_lights_blue", "deformMaterialDamaged":"policeparts_lights_blue"},
        ["generic_flasher_led_TRNK_L", ["sunburst2_trunk"], [], {"pos":{"x": 0.205, "y":2.138, "z":0.575}, "rot":{"x":85, "y":-29, "z":-30}, "scale":{"x":1.8, "y":0.9, "z":0.6}}],
		{"deformGroup":"", "deformMaterialBase":"", "deformMaterialDamaged":""},
    ],
    "props": [
        ["func"      , "mesh"              , "idRef:", "idX:", "idY:"            , "baseRotation"        , "rotation"                 , "translation"        , "min", "max", "offset", "multiplier"],
        {
            "lightInnerAngle":0,
            "lightOuterAngle":110,
            "lightRange":60,
            "lightBrightness": 1,
            "lightColor":{"r":10, "g":10, "b":255, "a":0},
            "lightAttenuation":{"x":1, "y":9999999, "z":9999999},
            "flareName":"vehicleBrakeLightFlare",
            "lightCastShadows":false,
            "texSize":32,
            "shadowSoftness":0,
            "flareScale":0.01,
            //"cookieName":"/vehicles/common/politi/half_cookie.png"
             "cookieName":"/art/special/BNG_light_cookie_lightbar.dds"
        },
        ["trunk_l", "SPOTLIGHT", "t4", "t3", "t4l", {"x":-90, "y":-90, "z":0} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0.0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.016, "y":0.719, "z":0.026},"deformGroup":"beaconlight_break_r"}],
        ["trunk_r", "SPOTLIGHT", "t4", "t3", "t4l", {"x":-90, "y":-90, "z":0} , {"x":0, "y":0, "z":0}    , {"x":0, "y":0.0, "z":0}, 0, 0, 0, 1, {"baseTranslation":{"x":0.016, "y":-0.719, "z":0.026},"deformGroup":"beaconlight_break_r"}],
    ],
},


